{
  "manifest_version": 3,
  "name": "链序 ChainTrace",
  "version": "1.4.0",
  "description": "自动查询 GMGN 活动的 Slot / Index，核对 Jito bundle 归属并加框，支持 1s K 线联动。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.mainnet-beta.solana.com/*",
    "https://bundles.jito.wtf/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "链序 ChainTrace · RPC 设置",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "short_name": "链序"
}
